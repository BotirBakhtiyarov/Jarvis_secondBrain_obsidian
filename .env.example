# --- Provider / model configuration -----------------------------------------

# Provider: deepseek (default) | anthropic | openai | gemini | ollama.
# Every provider speaks the OpenAI-compatible API, so only the key changes.
ORION_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Keys for the other providers (set the one you switch to):
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx
# OLLAMA_API_KEY=ollama   # optional; a local Ollama server needs no real key

# Optional overrides (apply to the active provider):
# ORION_MODEL=deepseek-reasoner
# ORION_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat      # legacy, deepseek only
# DEEPSEEK_BASE_URL=...             # legacy, deepseek only

OBSIDIAN_VAULT=/home/you/Work/SecondBrain

# Obsidian transport: file (default, direct disk access) | rest (Local REST API).
# "rest" talks to the community plugin and falls back to "file" when the
# server is unreachable.
# OBSIDIAN_TRANSPORT=file
# OBSIDIAN_API_URL=https://127.0.0.1:27124
# OBSIDIAN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Verify the plugin's TLS certificate (0 = accept the default self-signed cert).
# OBSIDIAN_API_VERIFY=0

# --- Telegram bot (optional) -------------------------------------------------
# Create a bot with @BotFather, then run `orion telegram` (or `orion --telegram`).
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Comma-separated chat IDs allowed to use the bot (empty = anyone who finds it).
# Get your id from @userinfobot — strongly recommended.
# TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Optional. If not set, the current terminal directory is used as the workspace.
# WORKSPACE=/home/you/Projects

# Optional. Enables the web_search tool (Tavily). Leave empty to fall back
# to DuckDuckGo (no key required).
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# Chat history location
ORION_HISTORY=~/.orion/history.json
ORION_MAX_HISTORY=50

# Interface language: en (default) | uz | auto (detected from your messages)
ORION_LANG=en

# Collapse long tool output and model thinking (1 = collapsed, 0 = show all).
# Collapsed sections can always be expanded with /show and /think.
ORION_COLLAPSE=1

# Cost tracking (USD per 1M tokens) — optional, defaults come from the provider
# ORION_INPUT_PRICE=0.27
# ORION_OUTPUT_PRICE=1.10
# DEEPSEEK_INPUT_PRICE=0.27    # legacy, deepseek only
# DEEPSEEK_OUTPUT_PRICE=1.10   # legacy, deepseek only
