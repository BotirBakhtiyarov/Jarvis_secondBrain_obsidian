DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OBSIDIAN_VAULT=/home/you/Work/SecondBrain

# Optional. If not set, the current terminal directory is used as the workspace.
# WORKSPACE=/home/you/Projects

# Optional. Enables the web_search tool (Tavily). Leave empty to fall back
# to DuckDuckGo (no key required).
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# Chat history location
ORION_HISTORY=~/.orion/history.json
ORION_MAX_HISTORY=50

# Interface language: en (default) | uz | auto (detected from your messages)
ORION_LANG=en

# Collapse long tool output and model thinking (1 = collapsed, 0 = show all).
# Collapsed sections can always be expanded with /show and /think.
ORION_COLLAPSE=1

# Cost tracking (USD per 1M tokens) — optional, defaults shown
# DEEPSEEK_INPUT_PRICE=0.27
# DEEPSEEK_OUTPUT_PRICE=1.10
